{
 "name": "دمج محافظ اللوحات",
 "short_name": "المحافظ",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "lang": "ar",
 "dir": "rtl",
 "background_color": "#ffffff",
 "theme_color": "#1d4ed8",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "file",
     "accept": [
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      ".xlsx",
      "application/vnd.ms-excel",
      ".xls",
      "text/csv",
      ".csv"
     ]
    }
   ]
  }
 }
}